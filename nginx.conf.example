# Nginx 配置文件示例
# 将此文件放置于 /etc/nginx/sites-available/ 目录下
# 并创建软链接到 /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name potatoma.me;  # 替换为你的域名

    # 根导航页面
    location = / {
        root /www/wwwroot/potatoma.me/my_website;  # 替换为实际路径
        index index.html;
    }

    # 新版网站 (AI运动评估系统)
    location /new/ {
        proxy_pass http://127.0.0.1:5001/;  # new 项目运行在 5001 端口
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket 支持 (如果需要)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # 旧版网站
    location /old/ {
        proxy_pass http://127.0.0.1:5002/;  # old 项目运行在 5002 端口
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket 支持 (如果需要)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # JM漫画查看器 + QQ机器人
    location /jm/ {
        proxy_pass http://127.0.0.1:5003/;  # jm 项目运行在 5003 端口
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;  # 下载漫画可能需要较长时间
    }

    # QQ机器人回调接口 (需要公网可访问)
    location /qq/callback {
        proxy_pass http://127.0.0.1:5003/qq/callback;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 静态文件缓存设置
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

